# Copy to .env. Never commit .env, because it holds your tunnel token.

# Where the game page is hosted. The server refuses browsers from anywhere else.
ALLOWED_ORIGINS=https://nparbs.github.io

# Database password. Letters and numbers only. Generate one with: openssl rand -hex 24
DB_PASSWORD=

# From Google Cloud, for "Sign in with Google". Leave empty for guest accounts only.
GOOGLE_CLIENT_ID=

# Pick one: tunnel or caddy
COMPOSE_PROFILES=tunnel

# Option 1: Cloudflare Tunnel
TUNNEL_TOKEN=
CLIENT_IP_HEADER=cf-connecting-ip

# Option 2: Caddy. Use these instead, and clear the two lines above.
# GAME_DOMAIN=game.example.com
# CLIENT_IP_HEADER=x-forwarded-for
